# Copy to .env and adjust. `docker compose up -d` reads this file.

# --- Web UI / API ---
# Host port the UI is served on (http://<server-ip>:CARSCOUT_PORT)
CARSCOUT_PORT=8097

# --- Database (internal to the compose network; not exposed on the host) ---
POSTGRES_USER=carscout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=carscout

# --- Scheduling ---
# Standard 5-field cron, in SCHEDULE_TZ. Default: every 6 hours on the hour.
SCRAPE_CRON=0 */6 * * *
SCHEDULE_TZ=Australia/Melbourne

# --- Politeness defaults (each source can override these in sources.yaml) ---
# Minimum seconds between requests to one source, plus random 0..JITTER on top.
DEFAULT_DELAY_SECONDS=4
DEFAULT_JITTER_SECONDS=3
# Parallel requests per source.
DEFAULT_CONCURRENCY=1
# Retries on 429/403/503 with exponential backoff (BACKOFF_BASE * 2^attempt seconds).
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=10
RESPECT_ROBOTS=true

# --- Sources ---
# Optional comma-separated allowlist that overrides `enabled:` in sources.yaml.
# Leave empty to use sources.yaml as-is. Example: ENABLED_SOURCES=cars24,carsales
ENABLED_SOURCES=

# --- Logging ---
LOG_LEVEL=INFO
